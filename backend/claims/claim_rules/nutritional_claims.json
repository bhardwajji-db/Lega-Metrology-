[
  {
    "rule_id": "CLAIM-RULE-NUT-001",
    "claim_type": "NO_ADDED_SUGAR",
    "category": "NUTRITIONAL",
    "jurisdiction": "IN",
    "source": "FSSAI (Advertising and Claims) Regulations, 2018",
    "source_reference": "Regulation 4(1) & Schedule I",
    "source_url": "https://www.fssai.gov.in/upload/uploadfiles/files/Advertising_Claims_Regulations_2018.pdf",
    "version": "1.0",
    "enabled": true,
    "description": "Claims of 'No Added Sugar' require that no sugars, syrups, honey, or concentrated fruit juice have been added to the product during manufacturing.",
    "patterns": [
      "no added sugar",
      "without added sugar",
      "zero added sugar",
      "0% added sugar",
      "no sugar added"
    ],
    "contradiction_ingredients": [
      "sugar", "cane sugar", "sucrose", "invert sugar", "glucose", "fructose",
      "corn syrup", "high fructose corn syrup", "jaggery", "honey", "dextrose",
      "maltodextrin", "liquid glucose", "molasses", "brown sugar", "gud", "sharkara"
    ],
    "requires_nutrition_panel": true,
    "max_added_sugar_g": 0.0,
    "risk_level": "HIGH",
    "requires_human_review": false
  },
  {
    "rule_id": "CLAIM-RULE-NUT-002",
    "claim_type": "SUGAR_FREE",
    "category": "NUTRITIONAL",
    "jurisdiction": "IN",
    "source": "FSSAI (Advertising and Claims) Regulations, 2018",
    "source_reference": "Schedule I, Table (Nutrition Claims)",
    "source_url": "https://www.fssai.gov.in/upload/uploadfiles/files/Advertising_Claims_Regulations_2018.pdf",
    "version": "1.0",
    "enabled": true,
    "description": "A 'Sugar Free' claim requires that the product contains no more than 0.5 g of sugars per 100 g (or 100 ml).",
    "patterns": [
      "sugar free",
      "sugar-free",
      "zero sugar",
      "0 sugar",
      "0% sugar",
      "free of sugar"
    ],
    "max_sugar_g_per_100g": 0.5,
    "contradiction_ingredients": [
      "sugar", "cane sugar", "sucrose", "invert sugar", "glucose", "fructose", "jaggery", "honey"
    ],
    "risk_level": "HIGH",
    "requires_human_review": false
  },
  {
    "rule_id": "CLAIM-RULE-NUT-003",
    "claim_type": "HIGH_PROTEIN",
    "category": "NUTRITIONAL",
    "jurisdiction": "IN",
    "source": "FSSAI (Advertising and Claims) Regulations, 2018",
    "source_reference": "Schedule II, Table (Nutrition Claims: High/Rich in Protein)",
    "source_url": "https://www.fssai.gov.in/upload/uploadfiles/files/Advertising_Claims_Regulations_2018.pdf",
    "version": "1.0",
    "enabled": true,
    "description": "A food claiming to be 'High in Protein' or 'Rich in Protein' shall contain not less than 12 g of protein per 100 g for solids, or 6 g of protein per 100 ml for liquids (or at least 20% of the nutrient RDA per serve).",
    "patterns": [
      "high protein",
      "rich in protein",
      "protein rich",
      "high in protein",
      "source of protein",
      "loaded with protein",
      "protein packed",
      "protein powerhouse"
    ],
    "min_protein_g_per_100g_solid": 12.0,
    "min_protein_g_per_100ml_liquid": 6.0,
    "risk_level": "MEDIUM",
    "requires_human_review": false
  },
  {
