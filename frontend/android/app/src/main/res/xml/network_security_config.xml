<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Allow both HTTPS and cleartext HTTP for local network testing, LAN IP backend (e.g. http://192.168.x.x:8000), and production HTTPS tunnels -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>

