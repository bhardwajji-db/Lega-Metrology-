# MetrCheck AI - Environment Configuration
# Copy this file to .env and update values as needed

# OCR Engine: 'paddleocr' (deep learning PP-OCRv4 engine)
OCR_ENGINE=paddleocr

# Environment & Demonstration Mode Settings:
# For local development / SIH presentation:
ENVIRONMENT=development
METRCHECK_DEMO_MODE=true

# For production deployment:
# ENVIRONMENT=production
# METRCHECK_DEMO_MODE=false

# Optional: LLM API Key for enhanced extraction
# Leave empty to use local regex-based extraction
LLM_API_KEY=

# Upload directory for product images
UPLOAD_DIR=./uploads

# SQLite database path
DATABASE_PATH=./metrc_check.db

# Maximum file upload size in MB
MAX_FILE_SIZE_MB=10

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Server
HOST=0.0.0.0
PORT=8000

# Font size calibration for Rule 12 (px -> mm conversion factor)
# 0.18 ≈ 300 DPI print scanned at ~141 dpi effective; for 300 DPI scans use 0.0847
FONT_PX_TO_MM_FACTOR=0.18
# OCR Image DPI (when set > 0, factor is auto-derived as 25.4 / OCR_IMAGE_DPI)
OCR_IMAGE_DPI=

# =============================================================================
# EXTERNAL VERIFICATION — Official Live API Configuration
# =============================================================================
# Controls whether the system uses real external APIs or runs in offline/mock mode.
# Values: "mock" (default, safe for demo/development) | "live" (requires API credentials below)
EXTERNAL_VERIFICATION_MODE=mock

# ── FSSAI / FoSCoS Official Registry API ──────────────────────────────────────
# HOW TO ENABLE LIVE FSSAI LOOKUP:
#   1. Apply for API access at https://foscos.fssai.gov.in (Government of India portal)
#   2. Set FSSAI_API_URL to the official endpoint (e.g. https://api.foscos.fssai.gov.in/v1/licences)
#   3. Set FSSAI_API_KEY to the Bearer token issued to your organization
#   4. Set FSSAI_API_ENABLED=true
#   5. Set EXTERNAL_VERIFICATION_MODE=live
#
# Without configuration: system reports format/checksum validation only.
# Status shown in reports: "NOT_VERIFIED" with manual FoSCoS portal URL.
FSSAI_API_ENABLED=false
FSSAI_API_URL=
FSSAI_API_KEY=
FSSAI_API_TIMEOUT_SEC=3.0

# ── GS1 India DataKart / Verified by GS1 API ─────────────────────────────────
# HOW TO ENABLE LIVE GS1 GTIN LOOKUP:
#   1. Become a GS1 India member: https://www.gs1india.org
#   2. Request DataKart API access from GS1 India
#   3. Set GS1_API_URL to the DataKart API base URL provided
#   4. Set GS1_API_KEY to your assigned Bearer token
#   5. Set GS1_API_ENABLED=true
#   6. Set EXTERNAL_VERIFICATION_MODE=live
#
# Without configuration: system uses local GS1 reference registry for known products.
# Status shown in reports: "LOCAL_REFERENCE_MATCH" (clearly not official external verification).
GS1_API_ENABLED=false
GS1_API_URL=
GS1_API_KEY=
GS1_API_TIMEOUT_SEC=3.0
